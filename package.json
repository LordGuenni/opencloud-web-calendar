{
  "name": "web-calendar",
  "version": "1.3.0",
  "description": "CalDAV Calendar App for OpenCloud",
  "license": "Apache-2.0",
  "author": "OpenCloud",
  "private": true,
  "homepage": "https://github.com/mschneider82/opencloud-web-calendar",
  "type": "module",
  "scripts": {
    "build": "pnpm vite build",
    "build:w": "pnpm vite build --watch --mode development",
    "check:types": "vue-tsc --noEmit",
    "lint": "eslint 'src/**/*.{js,ts,vue}' --color",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "test:unit": "NODE_OPTIONS=--unhandled-rejections=throw vitest"
  },
  "devDependencies": {
    "@opencloud-eu/eslint-config": "^7.4.0",
    "@opencloud-eu/prettier-config": "^7.4.0",
    "@opencloud-eu/tsconfig": "^7.4.0",
    "@opencloud-eu/web-client": "^7.4.0",
    "@opencloud-eu/web-pkg": "^7.4.0",
    "@types/node": "^24.19.1",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^9.39.5",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.12",
    "vue3-gettext": "^2.4.0"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@fullcalendar/vue3": "^6.1.21",
    "@opencloud-eu/extension-sdk": "^7.4.0",
    "fast-xml-parser": "^5.12.0",
    "ical.js": "^2.2.1"
  },
  "packageManager": "pnpm@10.18.1"
}
